# Deployment configuration — copy this file to .deploy.env and fill in your values.
# .deploy.env is gitignored and never committed to the repository.

# Path to the SSH private key used to connect to the server.
SSH_KEY="$HOME/.ssh/id_rsa"

# SSH target: user@hostname or user@ip-address. Shared by both environments;
# staging and prod live side-by-side on the same host, separated only by
# their remote working directory and their Docker container names.
SSH_HOST="user@your-server.example.com"

# Per-environment working directories on the remote host. Each holds its
# own app/, data/, pgdata/, backups/, .env and docker-compose.yml, so a
# deploy to one cannot touch the other's data.
#
# The active environment is chosen at deploy time via `./deploy.sh -prod`
# or `./deploy.sh -staging` (the script prompts if neither is given).
PROD_REMOTE_WORK_DIR="/home/user/noctalum"
STAGING_REMOTE_WORK_DIR="/home/user/noctalum-staging"
