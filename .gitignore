/dist/
.build-cache/
/contestlog
/contestlog-server
/contestlog.db
/helper
/helper-gui

# rigctld binaries fetched by fetch-rigctld.sh — not committed, generated at build time
cmd/helper/rigctld-bins/
cmd/helper-gui/rigctld-bins/

# Deployment secrets — copy .deploy.env.example → .deploy.env and fill in values
.deploy.env

# Docker-compose runtime secrets — POSTGRES_PASSWORD lives here on the server
# and locally for dev. Never commit.
.env

# Local Postgres bind mount + pg_dump output — populated by docker compose up
# and ./backup.sh respectively.
/pgdata/
/backups/

# SSH keys used to reach the production server — never commit these
/id_noctalum
/id_noctalum.pub

# Claude Code local settings (machine-specific paths and permissions)
.claude/settings.local.json

# macOS SDK tarball for osxcross cross-compile — Apple's SDK licence forbids
# redistribution.  See cpp/third_party/osxcross-sdk/README for how to package
# one from a Mac.
cpp/third_party/osxcross-sdk/*.tar.xz
